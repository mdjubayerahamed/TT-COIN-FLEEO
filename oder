import React, { useState } from 'react';
import { useQueryClient } from '@tanstack/react-query';
import { base44 } from '@/api/base44Client';
import { useLive, invalidateLive } from '@/lib/live';
import PageTitle from '@/components/admin/PageTitle';
import FilterBar from '@/components/admin/FilterBar';
import AdminOrderCard from '@/components/admin/AdminOrderCard';

const OPTIONS = [
  ['all', 'সব'],
  ['pending', 'পেন্ডিং'],
  ['processing', 'প্রসেসিং'],
  ['completed', 'সম্পন্ন'],
  ['cancelled', 'বাতিল'],
];

export default function AdminOrders() {
  const qc = useQueryClient();
  const { data: orders, isLoading } = useLive('Order');
  const [filter, setFilter] = useState('all');
  const [q, setQ] = useState('');

  const list = orders.filter(
    (o) =>
      (filter === 'all' || o.status === filter) &&
      [o.order_code, o.user_email, o.user_name, o.whatsapp, o.tiktok_username]
        .join(' ')
        .toLowerCase()
        .includes(q.toLowerCase())
  );

  const onStatus = async (o, status) => {
    if (status === 'cancelled' && !window.confirm('অর্ডার বাতিল করলে টাকা ইউজারের ব্যালেন্সে ফেরত যাবে। নিশ্চিত?')) return;
    await base44.entities.Order.update(o.id, { status });

    if (status === 'completed' && o.price >= 1000 && o.user_id) {
      try {
        const u = await base44.entities.User.get(o.user_id);
        if (u?.referred_by && u.referred_by !== o.user_id) {
          const existing = await base44.entities.Referral.filter({ referred_user_id: o.user_id, type: 'purchase' });
          if (existing.length === 0) {
            await base44.entities.Referral.create({
              referrer_id: u.referred_by,
              referred_user_id: o.user_id,
              type: 'purchase',
              amount: 5,
              status: 'paid',
              order_id: o.id,
            });
          }
        }
      } catch (e) {}
    }
    invalidateLive(qc, 'Order');
    invalidateLive(qc, 'Referral');
  };

  return (
    <div>
      <PageTitle title="অর্ডার ম্যানেজমেন্ট" subtitle={`মোট ${orders.length}টি অর্ডার`} />
      <FilterBar options={OPTIONS} value={filter} onChange={setFilter} q={q} onQ={setQ} />
      {isLoading ? (
        <div className="glass rounded-2xl h-40 animate-pulse" />
      ) : list.length === 0 ? (
        <div className="glass rounded-2xl p-10 text-center text-white/45">কোনো অর্ডার পাওয়া যায়নি</div>
      ) : (
        <div className="space-y-3">
          {list.map((o) => <AdminOrderCard key={o.id} order={o} onStatus={onStatus} />)}
        </div>
      )}
    </div>
  );
}
