import React from 'react';
import { Search } from 'lucide-react';
import { Input } from '@/components/ui/input';
import { fieldCls } from '@/lib/format';

export default function FilterBar({ options, value, onChange, q, onQ }) {
  return (
    <div className="flex flex-col sm:flex-row gap-3 mb-5">
      <div className="relative flex-1">
        <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-white/35" />
        <Input
          value={q}
          onChange={(e) => onQ(e.target.value)}
          placeholder="খুঁজুন..."
          className={`${fieldCls} pl-9`}
        />
      </div>
      <div className="flex gap-1 overflow-x-auto bg-white/[0.03] border border-white/10 rounded-xl p-1">
        {options.map(([k, label]) => (
          <button
            key={k}
            onClick={() => onChange(k)}
            className={`px-3 py-1.5 rounded-lg text-sm whitespace-nowrap transition ${
              value === k ? 'bg-white/10 text-white' : 'text-white/50 hover:text-white'
            }`}
          >
            {label}
          </button>
        ))}
      </div>
    </div>
  );
}
