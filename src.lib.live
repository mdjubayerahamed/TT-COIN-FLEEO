import { useEffect } from 'react';
import { useQuery, useQueryClient } from '@tanstack/react-query';
import { base44 } from '@/api/base44Client';

export function useLive(entity, { filter, sort = '-created_date', limit = 500, enabled = true } = {}) {
  const qc = useQueryClient();
  const query = useQuery({
    queryKey: ['live', entity, JSON.stringify(filter || {}), sort, limit],
    enabled,
    queryFn: () => filter ? base44.entities[entity].filter(filter, sort, limit) : base44.entities[entity].list(sort, limit),
  });
  useEffect(() => {
    if (!enabled) return;
    const unsubscribe = base44.entities[entity].subscribe(() => qc.invalidateQueries({ queryKey: ['live', entity] }));
    return unsubscribe;
  }, [entity, enabled, qc]);
  return { data: query.data || [], isLoading: enabled && query.isLoading };
}

export const invalidateLive = (qc, entity) => qc.invalidateQueries({ queryKey: ['live', entity] });
