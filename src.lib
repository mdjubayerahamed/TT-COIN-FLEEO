export const taka = (n) => `৳${Number(n || 0).toLocaleString('en-US', { maximumFractionDigits: 2 })}`;
export const num = (n) => Number(n || 0).toLocaleString('en-US');
export const fieldCls = 'bg-white/[0.04] border-white/10 h-11 rounded-xl text-white placeholder:text-white/30 focus-visible:ring-[#25F4EE]/40';

export const STATUS = {
  pending: { label: 'পেন্ডিং', cls: 'bg-amber-400/10 text-amber-300 border-amber-400/20' },
  processing: { label: 'প্রসেসিং', cls: 'bg-sky-400/10 text-sky-300 border-sky-400/20' },
  completed: { label: 'সম্পন্ন', cls: 'bg-emerald-400/10 text-emerald-300 border-emerald-400/20' },
  cancelled: { label: 'বাতিল', cls: 'bg-rose-400/10 text-rose-300 border-rose-400/20' },
  approved: { label: 'অনুমোদিত', cls: 'bg-emerald-400/10 text-emerald-300 border-emerald-400/20' },
  rejected: { label: 'প্রত্যাখ্যাত', cls: 'bg-rose-400/10 text-rose-300 border-rose-400/20' },
};

export const makeOrderCode = () => 'TT' + Date.now().toString(36).toUpperCase().slice(-6) + Math.random().toString(36).slice(2, 5).toUpperCase();
export const fmtDate = (d) => d ? new Date(d).toLocaleString('en-GB', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '';
export const packageDiscount = (p) => p.discount || (p.old_price > p.new_price ? Math.round((1 - p.new_price / p.old_price) * 100) : 0);
