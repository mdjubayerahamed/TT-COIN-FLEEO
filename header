import React from 'react';
import { Link, NavLink } from 'react-router-dom';
import { Wallet, LogIn, LogOut, Plus } from 'lucide-react';
import { base44 } from '@/api/base44Client';
import Logo from '@/components/brand/Logo';
import useMe from '@/hooks/useMe';
import useSettings from '@/hooks/useSettings';
import useWallet from '@/hooks/useWallet';
import { taka } from '@/lib/format';

const linkCls = ({ isActive }) =>
  `px-3.5 py-2 rounded-full text-sm transition-colors ${isActive ? 'bg-white/10 text-white' : 'text-white/55 hover:text-white'}`;

export default function Header() {
  const settings = useSettings();
  const { data: user } = useMe();
  const { balance } = useWallet(user);

  return (
    <header className="sticky top-0 z-40 border-b border-white/[0.06] bg-[#07080d]/70 backdrop-blur-xl">
      <div className="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-3">
        <Logo settings={settings} />
        <nav className="hidden md:flex items-center gap-1">
          <NavLink to="/" end className={linkCls}>হোম</NavLink>
          {user && <NavLink to="/dashboard" className={linkCls}>ড্যাশবোর্ড</NavLink>}
          {user && <NavLink to="/deposit" className={linkCls}>ব্যালেন্স যোগ</NavLink>}
          {user?.role === 'admin' && <NavLink to="/admin" className={linkCls}>অ্যাডমিন</NavLink>}
        </nav>
        {user ? (
          <div className="flex items-center gap-1.5">
            <Link to="/deposit" className="glass rounded-full pl-3 pr-1 py-1 flex items-center gap-2 text-sm hover:border-white/20 transition">
              <Wallet className="w-4 h-4 text-[#25F4EE]" />
              <span className="font-semibold tabular-nums">{taka(balance)}</span>
              <span className="w-7 h-7 rounded-full btn-glow grid place-items-center"><Plus className="w-3.5 h-3.5" /></span>
            </Link>
            <button onClick={() => base44.auth.logout('/')} title="লগআউট" className="p-2.5 rounded-full text-white/50 hover:text-white hover:bg-white/5 transition">
              <LogOut className="w-4 h-4" />
            </button>
          </div>
        ) : (
          <button onClick={() => base44.auth.redirectToLogin()} className="btn-glow rounded-full px-4 py-2 text-sm flex items-center gap-1.5">
            <LogIn className="w-4 h-4" /> লগইন
          </button>
        )}
      </div>
    </header>
  );
}
