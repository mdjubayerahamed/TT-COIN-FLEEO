import React, { useState } from 'react';
import { useQueryClient } from '@tanstack/react-query';
import { ExternalLink } from 'lucide-react';
import { base44 } from '@/api/base44Client';
import { useLive, invalidateLive } from '@/lib/live';
import { taka, fmtDate } from '@/lib/format';
import PageTitle from '@/components/admin/PageTitle';
import FilterBar from '@/components/admin/FilterBar';
import StatusBadge from '@/components/common/StatusBadge';

const OPTIONS = [
  ['all', 'সব'],
  ['pending', 'পেন্ডিং'],
  ['approved', 'অনুমোদিত'],
  ['rejected', 'প্রত্যাখ্যাত'],
];

export default function AdminDeposits() {
  const qc = useQueryClient();
  const { data: deposits, isLoading } = useLive('Deposit');
  const [filter, setFilter] = useState('pending');
  const [q, setQ] = useState('');

  const list = deposits.filter(
    (d) =>
      (filter === 'all' || d.status === filter) &&
      [d.transaction_id, d.user_email, d.user_name, d.payment_method_name]
        .join(' ')
        .toLowerCase()
        .includes(q.toLowerCase())
  );

  const setStatus = async (d, status) => {
    await base44.entities.Deposit.update(d.id, { status });
    invalidateLive(qc, 'Deposit');
  };

  return (
    <div>
      <PageTitle title="ডিপোজিট রিকোয়েস্ট" subtitle="অনুমোদন করলে ইউজারের ব্যালেন্স অটোমেটিক আপডেট হবে" />
      <FilterBar options={OPTIONS} value={filter} onChange={setFilter} q={q} onQ={setQ} />
      {isLoading ? (
        <div className="glass rounded-2xl h-40 animate-pulse" />
      ) : list.length === 0 ? (
        <div className="glass rounded-2xl p-10 text-center text-white/45">কোনো ডিপোজিট নেই</div>
      ) : (
        <div className="grid lg:grid-cols-2 gap-3">
          {list.map((d) => (
            <div key={d.id} className="glass rounded-2xl p-4 flex gap-4">
              {d.screenshot_url ? (
                <a href={d.screenshot_url} target="_blank" rel="noreferrer" className="relative shrink-0 group">
                  <img src={d.screenshot_url} alt="" className="w-20 h-24 rounded-xl object-cover" />
                  <ExternalLink className="w-4 h-4 absolute top-1.5 right-1.5 opacity-0 group-hover:opacity-100" />
                </a>
              ) : (
                <div className="w-20 h-24 rounded-xl bg-white/5 grid place-items-center text-[10px] text-white/30 shrink-0">No image</div>
              )}
              <div className="flex-1 min-w-0 text-sm">
                <div className="flex items-center justify-between gap-2">
                  <span className="font-heading font-bold text-lg">{taka(d.amount)}</span>
                  <StatusBadge status={d.status} />
                </div>
                <div className="text-white/70 truncate">{d.user_name} · {d.user_email}</div>
                <div className="text-white/45 truncate">
                  {d.payment_method_name} · TrxID: <span className="font-mono text-white/80">{d.transaction_id}</span>
                </div>
                {d.description && <div className="text-white/45 truncate">{d.description}</div>}
                <div className="text-xs text-white/35">{fmtDate(d.created_date)}</div>
                {d.status === 'pending' && (
                  <div className="flex gap-2 mt-3">
                    <button onClick={() => setStatus(d, 'approved')} className="rounded-xl px-4 py-1.5 bg-emerald-500/15 text-emerald-300 hover:brightness-125">Approve</button>
                    <button onClick={() => setStatus(d, 'rejected')} className="rounded-xl px-4 py-1.5 bg-rose-500/15 text-rose-300 hover:brightness-125">Reject</button>
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      )}
    </div>
  );
}
