import React from 'react';
import { MessageCircle, Send } from 'lucide-react';
import useSettings from '@/hooks/useSettings';

export default function SupportButtons() {
  const s = useSettings();
  const btns = [
    { href: s.waHref, label: `WhatsApp ${s.whatsapp_number}`, icon: MessageCircle, cls: 'bg-[#25D366] shadow-[0_10px_30px_-8px_rgba(37,211,102,0.7)]' },
    { href: s.tgHref, label: `Telegram ${s.telegram_username}`, icon: Send, cls: 'bg-[#229ED9] shadow-[0_10px_30px_-8px_rgba(34,158,217,0.7)]' },
  ];

  return (
    <div className="fixed right-4 bottom-24 md:bottom-6 z-40 flex flex-col gap-3">
      {btns.map(({ href, label, icon: Icon, cls }) => (
        <a key={label} href={href} target="_blank" rel="noreferrer" className="group flex items-center justify-end gap-2">
          <span className="hidden md:block opacity-0 translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300 glass-strong rounded-full px-3 py-1.5 text-xs whitespace-nowrap">
            {label}
          </span>
          <span className={`w-12 h-12 rounded-full grid place-items-center text-white hover:scale-110 transition-transform ${cls}`}>
            <Icon className="w-5 h-5" />
          </span>
        </a>
      ))}
    </div>
  );
}
