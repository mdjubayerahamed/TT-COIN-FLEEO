import React, { useEffect, useState } from 'react';
import { AnimatePresence } from 'framer-motion';
import { useLive } from '@/lib/live';
import SlideView from '@/components/home/SlideView';

export default function HeroSlider({ settings }) {
  const { data } = useLive('Slider', { sort: 'sort_order' });
  const active = data.filter((s) => s.is_active !== false);
  const slides = active.length
    ? active
    : [{ id: 'banner', title: settings.banner_title, subtitle: settings.banner_subtitle, image_url: settings.banner_image_url }];

  const [i, setI] = useState(0);

  useEffect(() => {
    if (slides.length < 2) return;
    const t = setInterval(() => setI((v) => (v + 1) % slides.length), 5000);
    return () => clearInterval(t);
  }, [slides.length]);

  const cur = slides[i % slides.length];

  return (
    <div className="relative rounded-3xl overflow-hidden aspect-[16/10] sm:aspect-[16/7] md:aspect-[21/8] border border-white/10 bg-white/[0.02]">
      <AnimatePresence initial={false}>
        <SlideView key={cur.id} slide={cur} />
      </AnimatePresence>
      {slides.length > 1 && (
        <div className="absolute bottom-4 right-5 flex gap-1.5 z-10">
          {slides.map((s, idx) => (
            <button
              key={s.id}
              onClick={() => setI(idx)}
              aria-label={`slide ${idx + 1}`}
              className={`h-1.5 rounded-full transition-all duration-500 ${idx === i % slides.length ? 'w-7 bg-white' : 'w-1.5 bg-white/35'}`}
            />
          ))}
        </div>
      )}
    </div>
  );
}
