import React from 'react';
import { motion } from 'framer-motion';
import { Coins } from 'lucide-react';
import { Image } from '@/components/ui/image';
import { taka, num, packageDiscount } from '@/lib/format';

export default function PackageCard({ pkg, index, onOrder }) {
  const on = pkg.is_active !== false;
  const discount = packageDiscount(pkg);

  return (
    <motion.div
      initial={{ opacity: 0, y: 18 }}
      whileInView={{ opacity: 1, y: 0 }}
      viewport={{ once: true }}
      transition={{ delay: (index % 8) * 0.05, duration: 0.5 }}
      className={`group relative glass rounded-3xl p-4 md:p-5 flex flex-col hover:border-white/20 hover:-translate-y-1 transition-[transform,border-color] duration-300 ${on ? '' : 'opacity-60'}`}
    >
      {discount > 0 && (
        <span className="absolute top-3 right-3 text-[11px] font-bold rounded-full px-2 py-0.5 bg-[#FE2C55] text-white">-{discount}%</span>
      )}
      <div className="relative h-16 w-16 md:h-20 md:w-20 mx-auto mt-3">
        <div className="absolute inset-0 rounded-full bg-[#25F4EE]/20 blur-2xl group-hover:bg-[#FE2C55]/30 transition-colors duration-500" />
        {pkg.image_url ? (
          <Image src={pkg.image_url} alt="" className="relative w-full h-full object-contain" fittingType="fit" />
        ) : (
          <div className="relative w-full h-full rounded-full bg-gradient-to-br from-[#25F4EE] via-[#8b5cf6] to-[#FE2C55] p-[2px]">
            <div className="w-full h-full rounded-full bg-[#0c0e15] grid place-items-center">
              <Coins className="w-7 h-7 md:w-8 md:h-8 text-[#25F4EE]" />
            </div>
          </div>
        )}
      </div>
      <div className="text-center mt-4">
        <div className="font-heading text-2xl md:text-3xl font-extrabold tracking-tight tabular-nums">{num(pkg.coin_amount)}</div>
        <div className="text-[10px] uppercase tracking-[0.25em] text-white/40">Coins</div>
      </div>
      {pkg.description && <p className="text-xs text-white/45 text-center mt-2 line-clamp-2">{pkg.description}</p>}
      <div className="flex items-baseline justify-center gap-2 mt-3">
        {pkg.old_price > 0 && <span className="text-xs md:text-sm text-white/35 line-through">{taka(pkg.old_price)}</span>}
        <span className="text-lg md:text-xl font-bold text-[#25F4EE]">{taka(pkg.new_price)}</span>
      </div>
      <div className="mt-auto pt-4 space-y-2.5">
        <div className="flex items-center justify-center gap-1.5 text-[11px] text-white/50">
          <span className={`w-1.5 h-1.5 rounded-full ${on ? 'bg-emerald-400 animate-pulse' : 'bg-rose-400'}`} />
          {on ? 'অ্যাভেইলেবল' : 'স্টক আউট'}
        </div>
        <button
          disabled={!on}
          onClick={() => onOrder(pkg)}
          className="w-full rounded-2xl py-2.5 text-sm btn-glow disabled:opacity-40 disabled:cursor-not-allowed"
        >
          {on ? 'অর্ডার করুন' : 'বন্ধ আছে'}
        </button>
      </div>
    </motion.div>
  );
}
